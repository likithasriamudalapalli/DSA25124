# Hashing using Separate Chaining, Linear Probing and Quadratic Probing

SIZE = 10


# Separate Chaining
class SeparateChaining:
    def __init__(self):
        self.table = [[] for _ in range(SIZE)]

    def insert(self, key):
        index = key % SIZE
        if key not in self.table[index]:
            self.table[index].append(key)

    def search(self, key):
        index = key % SIZE
        return key in self.table[index]

    def display(self):
        for i in range(SIZE):
            print(i, ":", self.table[i])


# Linear Probing
class LinearProbing:
    def __init__(self):
        self.table = [None] * SIZE

    def insert(self, key):
        index = key % SIZE

        for i in range(SIZE):
            new_index = (index + i) % SIZE

            if self.table[new_index] is None:
                self.table[new_index] = key
                return

        print("Hash table is full")

    def search(self, key):
        index = key % SIZE

        for i in range(SIZE):
            new_index = (index + i) % SIZE

            if self.table[new_index] is None:
                return False

            if self.table[new_index] == key:
                return True

        return False

    def display(self):
        for i in range(SIZE):
            print(i, ":", self.table[i])


# Quadratic Probing
class QuadraticProbing:
    def __init__(self):
        self.table = [None] * SIZE

    def insert(self, key):
        index = key % SIZE

        for i in range(SIZE):
            new_index = (index + i * i) % SIZE

            if self.table[new_index] is None:
                self.table[new_index] = key
                return

        print("Hash table is full")

    def search(self, key):
        index = key % SIZE

        for i in range(SIZE):
            new_index = (index + i * i) % SIZE

            if self.table[new_index] is None:
                return False

            if self.table[new_index] == key:
                return True

        return False

    def display(self):
        for i in range(SIZE):
            print(i, ":", self.table[i])


# Main Program
while True:
    print("\n--- HASHING OPERATIONS ---")
    print("1. Separate Chaining")
    print("2. Linear Probing")
    print("3. Quadratic Probing")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 4:
        print("Exiting Program")
        break

    if choice not in [1, 2, 3]:
        print("Invalid choice")
        continue

    if choice == 1:
        h = SeparateChaining()
    elif choice == 2:
        h = LinearProbing()
    else:
        h = QuadraticProbing()

    while True:
        print("\n1. Insert")
        print("2. Search")
        print("3. Display")
        print("4. Back to Main Menu")

        op = int(input("Enter operation: "))

        if op == 1:
            key = int(input("Enter key: "))
            h.insert(key)

        elif op == 2:
            key = int(input("Enter key to search: "))

            if h.search(key):
                print("Key found")
            else:
                print("Key not found")

        elif op == 3:
            h.display()

        elif op == 4:
            break

        else:
            print("Invalid operation")
