# Queue implementation using Array (List)

queue = []
MAX_SIZE = 5


# Function to insert an element into the queue
def enqueue():
    if len(queue) == MAX_SIZE:
        print("Queue Overflow! Queue is full.")
    else:
        value = int(input("Enter the element to enqueue: "))
        queue.append(value)
        print(value, "inserted into the queue.")


# Function to delete an element from the queue
def dequeue():
    if len(queue) == 0:
        print("Queue Underflow! Queue is empty.")
    else:
        value = queue.pop(0)
        print(value, "deleted from the queue.")


# Function to display the front element
def peek():
    if len(queue) == 0:
        print("Queue is empty.")
    else:
        print("Front element is:", queue[0])


# Function to display all elements
def display():
    if len(queue) == 0:
        print("Queue is empty.")
    else:
        print("Queue elements are:")
        for element in queue:
            print(element, end=" ")
        print()


# Menu-driven program
while True:
    print("\n----- QUEUE MENU -----")
    print("1. Enqueue")
    print("2. Dequeue")
    print("3. Peek")
    print("4. Display")
    print("5. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        enqueue()

    elif choice == 2:
        dequeue()

    elif choice == 3:
        peek()

    elif choice == 4:
        display()

    elif choice == 5:
        print("Program terminated.")
        break

    else:
        print("Invalid choice! Please try again.")
