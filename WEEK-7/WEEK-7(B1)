# Circular Queue implementation using Array

MAX_SIZE = 5

queue = [None] * MAX_SIZE
front = -1
rear = -1


# Function to insert an element
def enqueue():
    global front, rear

    # Check if queue is full
    if (rear + 1) % MAX_SIZE == front:
        print("Circular Queue is Full!")
        return

    value = int(input("Enter the element to enqueue: "))

    # If queue is empty
    if front == -1:
        front = 0
        rear = 0
    else:
        # Move rear circularly
        rear = (rear + 1) % MAX_SIZE

    queue[rear] = value

    print(value, "inserted into the queue.")


# Function to delete an element
def dequeue():
    global front, rear

    # Check if queue is empty
    if front == -1:
        print("Circular Queue is Empty!")
        return

    value = queue[front]

    # If only one element is present
    if front == rear:
        front = -1
        rear = -1
    else:
        # Move front circularly
        front = (front + 1) % MAX_SIZE

    print(value, "deleted from the queue.")


# Function to display front element
def peek():
    if front == -1:
        print("Circular Queue is Empty!")
    else:
        print("Front element is:", queue[front])


# Function to display all elements
def display():
    if front == -1:
        print("Circular Queue is Empty!")
        return

    print("Circular Queue elements are:")

    i = front

    while True:
        print(queue[i], end=" ")

        if i == rear:
            break

        i = (i + 1) % MAX_SIZE

    print()


# Menu-driven program
while True:

    print("\n----- CIRCULAR QUEUE MENU -----")
    print("1. Enqueue")
    print("2. Dequeue")
    print("3. Peek")
    print("4. Display")
    print("5. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        enqueue()

    elif choice == 2:
        dequeue()

    elif choice == 3:
        peek()

    elif choice == 4:
        display()

    elif choice == 5:
        print("Program terminated.")
        break

    else:
        print("Invalid choice! Please try again.")
