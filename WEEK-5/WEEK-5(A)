# Node class represents one node of the linked list
class Node:
    def __init__(self, data):
        self.data = data       # Store the data
        self.next = None       # Store the address of next node


# Linked List class
class SinglyLinkedList:
    def __init__(self):
        self.head = None       # Initially, the list is empty


    # 1. Create Linked List
    def create(self):
        n = int(input("Enter number of nodes: "))

        for i in range(n):
            data = int(input(f"Enter data for node {i + 1}: "))
            new_node = Node(data)

            # If list is empty, make new node the head
            if self.head is None:
                self.head = new_node
            else:
                # Traverse to the last node
                temp = self.head
                while temp.next is not None:
                    temp = temp.next

                # Link the new node at the end
                temp.next = new_node

        print("Linked List created successfully.")


    # 2. Insert at Beginning
    def insert_beginning(self):
        data = int(input("Enter data: "))

        new_node = Node(data)

        # New node points to the current head
        new_node.next = self.head

        # Make new node the new head
        self.head = new_node

        print("Node inserted at beginning.")


    # 3. Insert at End
    def insert_end(self):
        data = int(input("Enter data: "))

        new_node = Node(data)

        # If list is empty, new node becomes head
        if self.head is None:
            self.head = new_node
        else:
            # Traverse to the last node
            temp = self.head
            while temp.next is not None:
                temp = temp.next

            # Link new node after the last node
            temp.next = new_node

        print("Node inserted at end.")


    # 4. Insert at Index
    def insert_at_index(self):
        index = int(input("Enter index: "))
        data = int(input("Enter data: "))

        # Index cannot be negative
        if index < 0:
            print("Invalid index.")
            return

        new_node = Node(data)

        # Insert at beginning if index is 0
        if index == 0:
            new_node.next = self.head
            self.head = new_node
            print("Node inserted successfully.")
            return

        # Find the node before the required index
        temp = self.head

        for i in range(index - 1):
            if temp is None:
                print("Index out of range.")
                return
            temp = temp.next

        # If required position does not exist
        if temp is None:
            print("Index out of range.")
            return

        # Insert the new node
        new_node.next = temp.next
        temp.next = new_node

        print("Node inserted successfully.")


    # 5. Delete by Value
    def delete_by_value(self):
        value = int(input("Enter value to delete: "))

        # If list is empty
        if self.head is None:
            print("Linked List is empty.")
            return

        # If the first node contains the value
        if self.head.data == value:
            self.head = self.head.next
            print("Node deleted successfully.")
            return

        # Search for the value
        temp = self.head

        while temp.next is not None:
            if temp.next.data == value:
                # Skip the node containing the value
                temp.next = temp.next.next
                print("Node deleted successfully.")
                return

            temp = temp.next

        print("Value not found.")


    # 6. Delete First Node
    def delete_first(self):
        # Check if list is empty
        if self.head is None:
            print("Linked List is empty.")
            return

        # Move head to the second node
        self.head = self.head.next

        print("First node deleted successfully.")


    # 7. Delete Last Node
    def delete_last(self):
        # Check if list is empty
        if self.head is None:
            print("Linked List is empty.")
            return

        # If there is only one node
        if self.head.next is None:
            self.head = None
            print("Last node deleted successfully.")
            return

        # Traverse until the second-last node
        temp = self.head

        while temp.next.next is not None:
            temp = temp.next

        # Remove the last node
        temp.next = None

        print("Last node deleted successfully.")


    # 8. Count Number of Nodes
    def count_nodes(self):
        count = 0
        temp = self.head

        # Traverse through the entire list
        while temp is not None:
            count += 1
            temp = temp.next

        print("Number of nodes:", count)


    # 9. Display / Traverse
    def display(self):
        # Check if list is empty
        if self.head is None:
            print("Linked List is empty.")
            return

        temp = self.head

        print("Linked List:", end=" ")

        # Traverse and print every node
        while temp is not None:
            print(temp.data, end=" -> ")
            temp = temp.next

        print("None")


# Create an object of SinglyLinkedList
ll = SinglyLinkedList()


# Menu-driven program
while True:
    print("\n========== SINGLY LINKED LIST ==========")
    print("1. Create Linked List")
    print("2. Insert Beginning")
    print("3. Insert End")
    print("4. Insert at Index")
    print("5. Delete by Value")
    print("6. Delete First Node")
    print("7. Delete Last Node")
    print("8. Count Number of Nodes")
    print("9. Display / Traverse")
    print("10. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        ll.create()

    elif choice == 2:
        ll.insert_beginning()

    elif choice == 3:
        ll.insert_end()

    elif choice == 4:
        ll.insert_at_index()

    elif choice == 5:
        ll.delete_by_value()

    elif choice == 6:
        ll.delete_first()

    elif choice == 7:
        ll.delete_last()

    elif choice == 8:
        ll.count_nodes()

    elif choice == 9:
        ll.display()

    elif choice == 10:
        print("Program terminated.")
        break

    else:
        print("Invalid choice. Please try again.")
